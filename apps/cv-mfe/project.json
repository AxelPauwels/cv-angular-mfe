{
  "name": "cv-mfe",
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "projectType": "application",
  "prefix": "app",
  "sourceRoot": "apps/cv-mfe/src",
  "tags": [],
  "targets": {
    "build": {
      "executor": "@angular-architects/native-federation:build",
      "options": {},
      "configurations": {
        "production": {
          "target": "cv-mfe:esbuild:production"
        },
        "development": {
          "target": "cv-mfe:esbuild:development",
          "dev": true
        }
      },
      "defaultConfiguration": "production",
      "dependsOn": ["docs", "version-info"]
    },
    "serve": {
      "continuous": true,
      "readyWhen": {
        "url": "http://localhost:4300"
      },
      "executor": "@angular-architects/native-federation:build",
      "options": {
        "target": "cv-mfe:serve-original:development",
        "rebuildDelay": 0,
        "dev": true,
        "port": 4300,
        "outputPath": "dist/apps/cv-mfe-dev"
      },
      "dependsOn": ["docs", "version-info"]
    },
    "test": {
      "executor": "@angular/build:unit-test",
      "options": {
        "watch": false
      }
    },
    "docs": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{projectRoot}/src/**/*.ts",
        "!{projectRoot}/src/**/*.spec.ts",
        "{projectRoot}/src/**/*.html",
        "{projectRoot}/README.md",
        "{projectRoot}/.compodocrc.json",
        "{projectRoot}/tsconfig.app.json",
        "{workspaceRoot}/tools/compodoc/**/*"
      ],
      "outputs": ["{workspaceRoot}/dist/compodoc/cv-mfe"],
      "options": {
        "commands": [
          "cd apps/cv-mfe && compodoc -c .compodocrc.json",
          "node tools/compodoc/strip-empty-examples.mjs dist/compodoc/cv-mfe"
        ],
        "parallel": false,
        "cwd": "{workspaceRoot}"
      }
    },
    "serve-static": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "dependsOn": ["build"],
      "executor": "@nx/web:file-server",
      "options": {
        "buildTarget": "cv-mfe:build",
        "port": 4200,
        "staticFilePath": "dist/apps/cv-mfe/browser",
        "spa": true
      }
    },
    "esbuild": {
      "executor": "@angular/build:application",
      "outputs": ["{options.outputPath}"],
      "defaultConfiguration": "production",
      "options": {
        "outputPath": "dist/apps/cv-mfe",
        "browser": "apps/cv-mfe/src/main.ts",
        "tsConfig": "apps/cv-mfe/tsconfig.app.json",
        "assets": [
          {
            "glob": "**/*",
            "input": "apps/cv-mfe/public"
          },
          {
            "glob": "**/*",
            "input": "dist/compodoc/cv-mfe",
            "output": "api"
          },
          {
            "glob": "version.json",
            "input": "dist/.version-info"
          }
        ],
        "styles": ["apps/cv-mfe/src/styles.scss"],
        "polyfills": ["es-module-shims"]
      },
      "configurations": {
        "production": {
          "budgets": [
            {
              "type": "initial",
              "maximumWarning": "500kb",
              "maximumError": "1mb"
            },
            {
              "type": "anyComponentStyle",
              "maximumWarning": "4kb",
              "maximumError": "8kb"
            }
          ],
          "outputHashing": "all"
        },
        "development": {
          "optimization": false,
          "extractLicenses": false,
          "sourceMap": true
        }
      }
    },
    "serve-original": {
      "continuous": true,
      "readyWhen": {
        "signal": true
      },
      "executor": "@angular/build:dev-server",
      "defaultConfiguration": "development",
      "configurations": {
        "production": {
          "buildTarget": "cv-mfe:esbuild:production"
        },
        "development": {
          "buildTarget": "cv-mfe:esbuild:development"
        }
      },
      "options": {
        "port": 4300
      },
      "dependsOn": ["docs", "version-info"]
    },
    "version-info": {
      "executor": "nx:run-commands",
      "cache": true,
      "inputs": [
        "{workspaceRoot}/package.json",
        "{workspaceRoot}/tools/version-info/**/*"
      ],
      "outputs": ["{workspaceRoot}/dist/.version-info"],
      "options": {
        "command": "node tools/version-info/generate.mjs",
        "cwd": "{workspaceRoot}"
      }
    }
  }
}
